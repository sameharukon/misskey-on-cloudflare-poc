{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@misskey-cf/misskey-js-types": [
        "../misskey-js-types/src/index.ts"
      ],
      "@misskey-cf/packers": [
        "../packers/src/index.ts"
      ],
      "@misskey-cf/id": [
        "../id/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
