{
  "name": "@misskey-cf/media-container",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CF Container: sharp + ffmpeg media processing",
  "license": "AGPL-3.0-only",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/alts.test.ts src/twemoji-badge.test.ts src/proxy.test.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "build:image": "docker build -t misskey-cf-media:local .",
    "push:image": "node scripts/push-image.mjs"
  },
  "dependencies": {
    "@misskey-dev/sharp-read-bmp": "1.3.1",
    "blurhash": "^2.0.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
